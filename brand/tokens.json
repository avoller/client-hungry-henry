{
  "$description": "Hungry Henry brand tokens. Warm terracotta primary (hen/hearth) and yolk accent. Document colours are aliases only.",

  "$extensions": {
    "studio": {
      "client": "Hungry Henry",
      "tokensVersion": "1.0.0",
      "updated": "2026-09-21",
      "contrastTarget": "AA",
      "darkMode": false,
      "logo": {
        "primary": "logo.svg",
        "mono": "logo-mono.svg",
        "clearSpace": "Half the mark height on every side.",
        "minWidth": "24mm in print, 96px on screen."
      },
      "forbiddenColors": [],
      "notes": "Primary and accent extrapolated from the product name (hen, hearth, yolk) because no brand guidelines were supplied. Confirm before G1."
    }
  },

  "color": {
    "$type": "color",

    "primary": {
      "$description": "Hungry Henry terracotta. base is the colour used for subject fills.",
      "base": { "$value": "{color.primary.500}" },
      "on": { "$value": "#FFFFFF", "$description": "5.8:1 on base. Passes AA for body text." },
      "50": { "$value": "#FBEDEA" },
      "100": { "$value": "#F4D2CA" },
      "200": { "$value": "#E8A894" },
      "300": { "$value": "#D97C5C" },
      "400": { "$value": "#C85A38" },
      "500": { "$value": "#B43B1F" },
      "600": { "$value": "#9A311A" },
      "700": { "$value": "#7A2715" },
      "800": { "$value": "#5C1D10" },
      "900": { "$value": "#3F140B" }
    },

    "accent": {
      "$description": "Yolk gold. Used for one thing per view: cause stars, CRITICAL, position-to-own.",
      "base": { "$value": "#8A5A00" },
      "on": { "$value": "#FFFFFF", "$description": "Darkened past a conventional gold so white text clears 4.5:1." },
      "50": { "$value": "#FDF3DC" },
      "100": { "$value": "#F3E0A8" },
      "600": { "$value": "#734B00" },
      "700": { "$value": "#5C3C00" }
    },

    "neutral": {
      "$description": "Warmed a few percent toward terracotta so greys read as one system.",
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#FAF7F5" },
      "100": { "$value": "#F0EBE7" },
      "200": { "$value": "#E0D7D0" },
      "300": { "$value": "#C9BDB4" },
      "400": { "$value": "#A39489" },
      "500": { "$value": "#7D6E64" },
      "600": { "$value": "#5E524A" },
      "700": { "$value": "#463C36" },
      "800": { "$value": "#2F2824" },
      "900": { "$value": "#1C1714" },
      "1000": { "$value": "#0C0908" }
    },

    "semantic": {
      "success": {
        "base": { "$value": "#1F7A45" },
        "subtle": { "$value": "#E7F4EC" },
        "on": { "$value": "#FFFFFF" },
        "border": { "$value": "#A8D5B9" }
      },
      "warning": {
        "base": { "$value": "#8A5A00" },
        "subtle": { "$value": "#FDF3DC" },
        "on": { "$value": "#FFFFFF" },
        "border": { "$value": "#E8C97A" }
      },
      "danger": {
        "base": { "$value": "#A4192C" },
        "subtle": { "$value": "#FBE9EC" },
        "on": { "$value": "#FFFFFF" },
        "border": { "$value": "#EDB3BC" }
      },
      "info": {
        "base": { "$value": "{color.primary.600}" },
        "subtle": { "$value": "{color.primary.50}" },
        "on": { "$value": "#FFFFFF" }
      }
    },

    "chart": {
      "$description": "Ordered categorical series. Luminance is spread so the sequence survives greyscale print.",
      "series-1": { "$value": "#B43B1F" },
      "series-2": { "$value": "#5C6B8A" },
      "series-3": { "$value": "#3D6B4F" },
      "series-4": { "$value": "#8A5A00" },
      "series-5": { "$value": "#6B4A6E" },
      "series-6": { "$value": "#A39489" },
      "grid": { "$value": "{color.neutral.200}" },
      "axis": { "$value": "{color.neutral.400}" }
    },

    "surface": {
      "page": { "$value": "{color.neutral.0}" },
      "raised": { "$value": "{color.neutral.0}" },
      "sunken": { "$value": "{color.neutral.50}" },
      "border": { "$value": "{color.neutral.200}" },
      "text": { "$value": "{color.neutral.900}" },
      "textMuted": { "$value": "{color.neutral.600}" },
      "textInverse": { "$value": "{color.neutral.0}" },
      "focusRing": { "$value": "{color.primary.500}" }
    }
  },

  "typography": {
    "family": {
      "$type": "fontFamily",
      "document": {
        "$value": ["Cambria", "Georgia", "serif"],
        "$description": "Word takes the first entry only."
      },
      "documentHeading": { "$value": ["Cambria", "Georgia", "serif"] },
      "ui": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "scale": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "0.125rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.75rem" },
    "full": { "$value": "9999px" }
  },

  "document": {
    "tableHeaderFill": {
      "$value": "{color.primary.50}",
      "$description": "Pale tint. High contrast against header text."
    },
    "tableHeaderText": { "$value": "{color.primary.700}" },
    "tableBodyText": { "$value": "{color.neutral.900}" },
    "tableBandFill": { "$value": "{color.neutral.50}" },
    "tableBorder": { "$value": "{color.neutral.200}" },
    "captionText": { "$value": "{color.neutral.600}" },
    "headingText": { "$value": "{color.primary.700}" },
    "linkText": { "$value": "{color.primary.600}" },
    "ruleLine": { "$value": "{color.neutral.300}" },
    "bodyFamily": { "$value": "{typography.family.document}" },
    "headingFamily": { "$value": "{typography.family.documentHeading}" },
    "bodySize": { "$value": "11pt" },
    "captionSize": { "$value": "9pt" }
  }
}
