{
  "$description": "Hungry Henry tokens from https://coolors.co/adc698-d0e3c4-ffffff-503047-b43b1f. Named colours: Muted Olive, Tea Green, White, Blackberry Cream, Rusty Spice. Ramps in OKLCH (Foundation / Atlassian steps). Document colours are aliases only.",

  "$extensions": {
    "studio": {
      "client": "Hungry Henry",
      "tokensVersion": "2.0.0",
      "updated": "2026-09-22",
      "contrastTarget": "AA",
      "darkMode": false,
      "logo": {
        "primary": "logo.svg",
        "mono": "logo-mono.svg",
        "clearSpace": "Half the mark height on every side.",
        "minWidth": "24mm in print, 96px on screen."
      },
      "forbiddenColors": [],
      "notes": "Coolors: Muted Olive #ADC698 (accent.200), Tea Green #D0E3C4 (accent.100), White #FFFFFF (neutral.0), Blackberry Cream #503047 (neutral.700), Rusty Spice #B43B1F (primary.600 — luminance puts it on 600, not 500). Olive and tea-green are display washes on white (1.86:1 and 1.36:1); ink on them is Blackberry Cream. Olive text uses accent.600 (6.35:1). Figma paint styles use the same names (muted-olive/700, rusty-spice/600, …) including 75 steps that the token schema does not carry. Restaurant names use Fraunces; chrome stays Inter."
    }
  },

  "color": {
    "$type": "color",

    "primary": {
      "$description": "Rusty Spice. The supplied #B43B1F is 600, unshifted. 500 is one step lighter. Match CTA uses 600.",
      "base": { "$value": "{color.primary.600}" },
      "on": { "$value": "#FFFFFF", "$description": "5.86:1 on 600. Passes AA for body text." },
      "50": { "$value": "#FFF2EE" },
      "100": { "$value": "#FFD7CD" },
      "200": { "$value": "#FFB6A4" },
      "300": { "$value": "#FF866A" },
      "400": { "$value": "#E3674A", "$description": "3.33:1 on white. Large text only." },
      "500": { "$value": "#C44A2E", "$description": "4.81:1 on white. Derived; not the Coolors swatch." },
      "600": { "$value": "#B43B1F", "$description": "Supplied Rusty Spice. 5.86:1 on white." },
      "700": { "$value": "#860200", "$description": "10.38:1 on white. Link and small text." },
      "800": { "$value": "#540000" },
      "900": { "$value": "#360000" }
    },

    "accent": {
      "$description": "Muted Olive family. 100 is the supplied Tea Green; 200 is the supplied Muted Olive. Neither is body text on white.",
      "base": { "$value": "{color.accent.200}" },
      "on": { "$value": "{color.neutral.700}", "$description": "Blackberry Cream on Muted Olive is 6.10:1." },
      "50": { "$value": "#EFF9E8" },
      "100": { "$value": "#D0E3C4", "$description": "Supplied Tea Green. 1.36:1 on white — wash only. Blackberry Cream on it is 8.34:1." },
      "200": { "$value": "#ADC698", "$description": "Supplied Muted Olive. 1.86:1 on white — large fill only. Blackberry Cream on it is 6.10:1." },
      "300": { "$value": "#9FB78A" },
      "400": { "$value": "#839B6F", "$description": "3.05:1 on white. Large text only." },
      "500": { "$value": "#698055", "$description": "4.36:1 on white. Fails AA body text; use 600." },
      "600": { "$value": "#50663C", "$description": "6.35:1 on white. Olive used as text, icons, and match-data indicators." },
      "700": { "$value": "#384C24", "$description": "9.43:1 on white; 8.70:1 on 50." },
      "800": { "$value": "#202E13" },
      "900": { "$value": "#091600" }
    },

    "neutral": {
      "$description": "Blackberry Cream. 0 is White. 700 is the supplied #503047, unshifted. Greys stay in the plum hue.",
      "0": { "$value": "#FFFFFF", "$description": "Supplied White." },
      "50": { "$value": "#FFF0FA" },
      "100": { "$value": "#F0DAE9" },
      "200": { "$value": "#DFC0D5" },
      "300": { "$value": "#C7A0BB" },
      "400": { "$value": "#AA859F", "$description": "3.20:1 on white. Border." },
      "500": { "$value": "#8E6A83", "$description": "4.63:1 on white. Muted text; phone chrome." },
      "600": { "$value": "#735169", "$description": "6.75:1 on white." },
      "700": { "$value": "#503047", "$description": "Supplied Blackberry Cream. 11.32:1 on white. Body ink." },
      "800": { "$value": "#362130" },
      "900": { "$value": "#1D0918" },
      "1000": { "$value": "#0A0007" }
    },

    "semantic": {
      "success": {
        "$description": "Muted Olive 600, not a second green.",
        "base": { "$value": "{color.accent.600}" },
        "subtle": { "$value": "{color.accent.50}" },
        "on": { "$value": "#FFFFFF", "$description": "6.35:1 on base." },
        "border": { "$value": "{color.accent.200}" }
      },
      "warning": {
        "$description": "Darkened past a conventional amber so white text clears 4.5:1.",
        "base": { "$value": "#8A5A00" },
        "subtle": { "$value": "#FDF3DC" },
        "on": { "$value": "#FFFFFF", "$description": "5.93:1 on base." },
        "border": { "$value": "#E8C97A" }
      },
      "danger": {
        "$description": "A true crimson, distinct from Rusty Spice so error never reads as Match.",
        "base": { "$value": "#A4192C" },
        "subtle": { "$value": "#FBE9EC" },
        "on": { "$value": "#FFFFFF", "$description": "7.63:1 on base." },
        "border": { "$value": "#EDB3BC" }
      },
      "info": {
        "base": { "$value": "{color.primary.600}" },
        "subtle": { "$value": "{color.primary.50}" },
        "on": { "$value": "#FFFFFF", "$description": "5.86:1 on base." }
      }
    },

    "chart": {
      "$description": "Rusty Spice and Muted Olive are not adjacent. Luminance is spread for greyscale print.",
      "series-1": { "$value": "{color.primary.600}" },
      "series-2": { "$value": "{color.neutral.700}" },
      "series-3": { "$value": "{color.accent.600}" },
      "series-4": { "$value": "#5B8ABB" },
      "series-5": { "$value": "{color.primary.400}" },
      "series-6": { "$value": "{color.neutral.500}" },
      "grid": { "$value": "{color.neutral.200}" },
      "axis": { "$value": "{color.neutral.400}" }
    },

    "surface": {
      "page": { "$value": "{color.neutral.0}" },
      "raised": { "$value": "{color.neutral.0}" },
      "sunken": { "$value": "{color.neutral.50}" },
      "border": { "$value": "{color.neutral.400}", "$description": "3.20:1 on page." },
      "text": { "$value": "{color.neutral.700}", "$description": "Blackberry Cream. 11.32:1 on page." },
      "textMuted": { "$value": "{color.neutral.500}", "$description": "4.63:1 on page. Lighter than 600 so chrome is not overpowering." },
      "textInverse": { "$value": "{color.neutral.0}" },
      "focusRing": { "$value": "{color.primary.600}", "$description": "5.86:1 on page." }
    }
  },

  "typography": {
    "family": {
      "$type": "fontFamily",
      "document": {
        "$value": ["Cambria", "Georgia", "serif"],
        "$description": "Word takes the first entry only."
      },
      "documentHeading": { "$value": ["Cambria", "Georgia", "serif"] },
      "ui": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "display": {
        "$value": ["Fraunces", "Georgia", "serif"],
        "$description": "Restaurant names and menu items. Chrome stays Inter."
      },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "scale": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    }
  },

  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "0.125rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.75rem" },
    "full": { "$value": "9999px" }
  },

  "document": {
    "tableHeaderFill": {
      "$value": "{color.accent.100}",
      "$description": "Tea Green. Blackberry Cream header text on it is 8.34:1."
    },
    "tableHeaderText": { "$value": "{color.neutral.700}" },
    "tableBodyText": { "$value": "{color.neutral.900}" },
    "tableBandFill": { "$value": "{color.neutral.50}" },
    "tableBorder": { "$value": "{color.neutral.400}" },
    "captionText": { "$value": "{color.neutral.500}" },
    "headingText": { "$value": "{color.neutral.700}" },
    "linkText": { "$value": "{color.primary.600}" },
    "ruleLine": { "$value": "{color.neutral.400}" },
    "bodyFamily": { "$value": "{typography.family.document}" },
    "headingFamily": { "$value": "{typography.family.documentHeading}" },
    "bodySize": { "$value": "11pt" },
    "captionSize": { "$value": "9pt" }
  }
}
